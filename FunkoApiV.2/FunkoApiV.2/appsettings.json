{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funko-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ApiSettings": {
    "Name": "Production"
  },
  "DatabaseSettings": {
    "Name": "funko"
  },
  "Cache": {
    "Name": "Redis",
    "ExpiryMinutes": 30,
    "SlidingExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "Postgre": "Host=localhost;Port=5432;Database=funkos;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  },
  "Storage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "AllowedContentTypes": ["image/jpeg", "image/jpeg", "image/png", "image/webp"]
  },
  "Jwt": {
    "Key": "EstaEsUnaClaveSecretaMuySeguraYDeMasDe16Caracteres!",
    "Issuer": "FunkoApi",
    "Audience": "FunkoApi",
    "ExpirationMin": 30
  }
}