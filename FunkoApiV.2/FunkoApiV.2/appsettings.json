{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funko-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "DatabaseSettings": {
    "Name": "funko"
  },
  "Cache": {
    "Name": "Redis",
    "ExpiryMinutes": 30,
    "SlidingExpirationMinutes": 60
  },
  "Storage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "Jwt": {
    "Issuer": "FunkoApi",
    "Audience": "FunkoApi",
    "ExpirationMin": 30
  },
  "Cassandra": {
    "Keyspace": "funkos"
  },
  "AllowedHosts": "*"
}
