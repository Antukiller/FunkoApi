  url: {{baseUrl}}/api/funkos/{{funkoId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Kirito actualizado",
    "precio": 16.50,
    "categoriaId": "{{categoriaId}}",
    "proveedorId": "{{proveedorId}}",
    "stock": 7
  }
}
