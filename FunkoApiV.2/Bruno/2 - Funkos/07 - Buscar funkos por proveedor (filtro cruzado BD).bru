meta {
  name: Buscar funkos por proveedor (filtro cruzado BD)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/funkos?proveedorId={{proveedorIdCreado}}&page=0&size=10
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("items es un array", function() {
    expect(res.body.items).to.be.an("array");
  });
  test("todos tienen el proveedorId", function() {
    var items = res.body.items;
    for (var i = 0; i < items.length; i++) {
      expect(items[i].proveedorId).to.equal(bru.getEnvVar("proveedorIdCreado"));
    }
  });
}
