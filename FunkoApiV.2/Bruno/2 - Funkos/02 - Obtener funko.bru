meta {
  name: Obtener funko por id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/funkos/{{funkoId}}
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id coincide", function() {
    expect(res.body.id).to.equal(parseInt(bru.getEnvVar("funkoId")));
  });
  test("tiene nombre y precio", function() {
    expect(res.body.name).to.be.a("string");
    expect(res.body.precio).to.be.a("number");
  });
}
