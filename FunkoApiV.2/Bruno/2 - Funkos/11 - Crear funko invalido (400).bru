meta {
  name: Crear funko invalido (400)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/funkos
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "",
    "precio": -5,
    "categoriaId": "",
    "proveedorId": "invalido",
    "stock": -1,
    "imagen": ""
  }
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("cuerpo tiene mensaje", function() {
    expect(res.body.message).to.be.a("string");
  });
}
