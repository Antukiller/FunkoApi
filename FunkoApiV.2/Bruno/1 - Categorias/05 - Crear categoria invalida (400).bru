meta {
  name: Crear categoria invalida (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/categorias
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "nombre": "",
    "descripcion": "Sin nombre"
  }
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("cuerpo tiene mensaje", function() {
    expect(res.body.message).to.be.a("string");
  });
}
