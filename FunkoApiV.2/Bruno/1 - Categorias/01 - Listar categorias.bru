meta {
  name: Listar categorias
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/categorias
  body: none
  auth: none
}

params:query {
  page: 0
  size: 10
  sortBy: nombre
  direction: asc
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("items es un array", function() {
    expect(res.body.items).to.be.an("array");
  });
  test("total mayor que 0", function() {
    expect(res.body.totalCount).to.be.greaterThan(0);
  });
}
